# Lab 1 source database, used by the one-time MySQL -> MongoDB migration script.
DATABASE_URL=mysql+pymysql://root:your_mysql_password@localhost:3306/lab1_yelp

# Lab 2 runtime database and storage settings.
MONGODB_URL=mongodb://localhost:27017
MONGODB_DATABASE=lab2_yelp
UPLOADS_DIR=uploads

# Security and session settings
JWT_SECRET_KEY=change-this-to-a-long-random-secret
SECRET_KEY=change-this-to-a-long-random-secret
JWT_ALGORITHM=HS256
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Kafka / async review processing
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_REVIEW_CREATED=review.created
KAFKA_TOPIC_REVIEW_UPDATED=review.updated
KAFKA_TOPIC_REVIEW_DELETED=review.deleted
KAFKA_TOPIC_REVIEW_STATUS=booking.status
REVIEW_STATUS_CONSUMER_ENABLED=true

# CORS
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080,http://127.0.0.1:8080

# Optional: Tavily for live restaurant context in AI assistant
TAVILY_API_KEY=
